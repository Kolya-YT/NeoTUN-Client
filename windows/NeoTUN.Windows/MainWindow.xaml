<Window x:Class="NeoTUN.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NeoTUN" Width="1100" Height="720" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen" WindowState="Normal" ResizeMode="CanResize" SizeToContent="Manual">
  <Grid x:Name="MainRoot" Background="{StaticResource BackgroundBrush}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="{StaticResource NavigationBrush}" BorderBrush="{StaticResource BorderBrushNeo}" BorderThickness="0,0,1,0">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Margin="20,22,20,24">
          <StackPanel Orientation="Horizontal">
            <Border Width="36" Height="36" CornerRadius="12" Background="{StaticResource AccentSurfaceBrush}" BorderBrush="{StaticResource BorderBrushNeo}" BorderThickness="1">
              <TextBlock Text="N" Foreground="{StaticResource BrandVioletBrush}" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Margin="11,1,0,0">
              <TextBlock Text="NeoTUN" FontWeight="Bold" FontSize="21"/>
              <TextBlock Text="CLIENT" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
            </StackPanel>
          </StackPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="18,12,18,18">
          <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushNeo}" BorderThickness="1" CornerRadius="14" Padding="12">
            <StackPanel>
              <TextBlock Text="СОСТОЯНИЕ" FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding ConnectionLabel}" FontSize="14" FontWeight="SemiBold" Margin="0,5,0,0"/>
              <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
            </StackPanel>
          </Border>
          <TextBlock Text="NeoTUN • Windows" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="2,16,0,0"/>
        </StackPanel>
        <StackPanel Margin="12,0,12,0">
          <TextBlock Text="РАБОЧЕЕ ПРОСТРАНСТВО" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="SemiBold" Margin="10,0,0,10"/>
          <Button Content="⌂   Главная" HorizontalContentAlignment="Left" Margin="0,0,0,6" Click="HomeNav_Click" Background="{StaticResource AccentSurfaceBrush}" BorderBrush="{StaticResource AccentSurfaceBrush}"/>
          <Button Content="▤   Серверы" HorizontalContentAlignment="Left" Margin="0,0,0,6" Click="ServersNav_Click"/>
          <Button Content="⤴   Маршрутизация" HorizontalContentAlignment="Left" Margin="0,0,0,6" Click="RoutingNav_Click"/>
          <Button Content="⚙   Настройки" HorizontalContentAlignment="Left" Margin="0,0,0,6" Click="SettingsNav_Click"/>
          <Button Content="☷   Журнал" HorizontalContentAlignment="Left" Margin="0,0,0,6" Click="LogsNav_Click"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1" Margin="30,24,30,22" Background="{StaticResource BackgroundBrush}">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Grid.Row="0" Margin="0,0,0,24">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="{Binding ActivePage}" FontSize="26" FontWeight="Bold"/>
          <TextBlock Text="Безопасное и быстрое подключение" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0"/>
        </StackPanel>
        <Button Grid.Column="1" Content="＋  Импорт" Background="{StaticResource BrandVioletBrush}" BorderBrush="{StaticResource BrandVioletBrush}" Click="ImportNav_Click" VerticalAlignment="Center"/>
      </Grid>

      <Grid Grid.Row="1">
        <Grid x:Name="HomePage">
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushNeo}" BorderThickness="1" CornerRadius="24" Padding="28">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Margin="4,0,20,0">
                <Border Background="{StaticResource AccentSurfaceBrush}" BorderBrush="{StaticResource BorderBrushNeo}" BorderThickness="1" CornerRadius="20" Padding="14" HorizontalAlignment="Left">
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="NEOTUN CONNECTION" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontWeight="SemiBold"/>
                  </StackPanel>
                </Border>
                <TextBlock Text="{Binding ConnectionLabel}" FontSize="36" FontWeight="Bold" Margin="0,20,0,0"/>
                <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="14" Margin="0,8,0,0"/>
                <TextBlock Text="Выбранный сервер" Foreground="{StaticResource TextMutedBrush}" Margin="0,30,0,8"/>
                <Border Background="{StaticResource InputSurfaceBrush}" BorderBrush="{StaticResource BorderBrushNeo}" BorderThickness="1" CornerRadius="14" Padding="14">
                  <StackPanel>
                    <TextBlock Text="{Binding SelectedProfileName}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding SelectedEndpoint}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding SelectedProfileProtocol}" Foreground="{StaticResource BrandVioletBrush}" FontSize="11" Margin="0,8,0,0"/>
                  </StackPanel>
                </Border>
              </StackPanel>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Button x:Name="ConnectButton" Width="164" Height="164" Padding="12" Background="{StaticResource BrandVioletBrush}" BorderBrush="{StaticResource BrandBlueBrush}" BorderThickness="4" Click="Connect_Click">
                  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="⏻" FontSize="56" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="ConnectLabel" Text="ПОДКЛЮЧИТЬ" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                  </StackPanel>
                </Button>
                <TextBlock Text="Скорость и трафик обновляются после успешного запуска TUN" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Width="230" Margin="0,20,0,0"/>
              </StackPanel>
            </Grid>
          </Border>
          <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushNeo}" BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,0,8,0">
              <StackPanel><TextBlock Text="СКОРОСТЬ" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/><TextBlock x:Name="HomeSpeedText" Text="0 B/s" FontSize="22" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="Входящий ↓ / исходящий ↑" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel>
            </Border>
            <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushNeo}" BorderThickness="1" CornerRadius="16" Padding="16" Margin="4,0">
              <StackPanel><TextBlock Text="ПОЛУЧЕНО" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/><TextBlock x:Name="HomeReceivedText" Text="0 B" FontSize="22" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="За текущий сеанс" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel>
            </Border>
            <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushNeo}" BorderThickness="1" CornerRadius="16" Padding="16" Margin="8,0,0,0">
              <StackPanel><TextBlock Text="ОТПРАВЛЕНО" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/><TextBlock x:Name="HomeSentText" Text="0 B" FontSize="22" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="За текущий сеанс" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel>
            </Border>
          </Grid>
        </Grid>

        <Grid x:Name="ServersPage" Visibility="Collapsed">
          <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="0.95*"/></Grid.ColumnDefinitions>
          <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushNeo}" BorderThickness="1" CornerRadius="20" Padding="18" Margin="0,0,10,0">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Поиск серверов" Margin="0,0,0,10"/>
                <Button Content="＋  Добавить из буфера / ссылки" Click="ImportNav_Click" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
                <Button x:Name="RefreshSubscriptionsButton" Content="↻  Обновить подписки" Click="RefreshSubscriptions_Click" HorizontalAlignment="Stretch"/>
              </StackPanel>
              <ListBox x:Name="ProfileList" ItemsSource="{Binding FilteredProfiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate><DataTemplate>
                  <Border Background="{StaticResource RaisedSurfaceBrush}" BorderBrush="{StaticResource BorderBrushNeo}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,8">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Endpoint}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding Protocol}" Foreground="{StaticResource BrandVioletBrush}" FontSize="10" Margin="0,6,0,0"/>
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="›" Foreground="{StaticResource TextMutedBrush}" FontSize="24" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </Grid>
                  </Border>
                </DataTemplate></ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </Border>
          <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushNeo}" BorderThickness="1" CornerRadius="20" Padding="20" Margin="10,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <TextBlock Text="Параметры сервера" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="Название" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,18,0,6"/>
                <TextBox x:Name="ProfileName" Text="{Binding SelectedProfileName, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}" />
                <TextBlock Text="Ссылка подключения" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,16,0,6"/>
                <TextBox x:Name="ProfileUri" Text="{Binding SelectedProfileUri, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}" MinHeight="84" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                <TextBlock Text="{Binding SelectedEndpoint}" Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0"/>
                <WrapPanel Margin="0,22,0,0">
                  <Button Content="Сохранить" Background="{StaticResource BrandVioletBrush}" BorderBrush="{StaticResource BrandVioletBrush}" Click="SaveProfile_Click" Margin="0,0,8,8"/>
                  <Button Content="Копировать ссылку" Click="CopyProfile_Click" Margin="0,0,8,8"/>
                  <Button Content="Удалить" Background="{StaticResource DangerSurfaceBrush}" BorderBrush="{StaticResource DangerSurfaceBrush}" Click="DeleteProfile_Click" Margin="0,0,8,8"/>
                </WrapPanel>
                <TextBlock Text="{Binding Notice}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,14,0,0"/>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
        <Grid x:Name="ImportPage" Visibility="Collapsed">
          <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushNeo}" BorderThickness="1" CornerRadius="20" Padding="24" MaxWidth="900" HorizontalAlignment="Left">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <TextBlock Text="Добавить серверы или подписку" FontSize="20" FontWeight="Bold"/>
              <TextBlock Grid.Row="1" Text="Вставьте ссылку VLESS / VMess / Trojan / Hysteria2 / TUIC / Shadowsocks либо содержимое подписки." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,16"/>
              <TextBox Grid.Row="2" x:Name="ImportEditor" Text="{Binding ImportText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="250" VerticalContentAlignment="Top"/>
              <WrapPanel Grid.Row="3" Margin="0,14,0,0">
                <Button x:Name="ImportProfilesButton" Content="Импортировать" Background="{StaticResource BrandVioletBrush}" BorderBrush="{StaticResource BrandVioletBrush}" Click="ImportProfiles_Click" Margin="0,0,8,0"/>
                <Button Content="Вставить из буфера" Click="PasteImport_Click" Margin="0,0,8,0"/>
                <Button Content="Очистить" Click="ClearImport_Click"/>
              </WrapPanel>
              <TextBlock Grid.Row="4" Text="{Binding Notice}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,14,0,0"/>
            </Grid>
          </Border>
        </Grid>
        <Grid x:Name="RoutingPage" Visibility="Collapsed">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushNeo}" BorderThickness="1" CornerRadius="18" Padding="20" Margin="0,0,0,14">
                <StackPanel>
                  <TextBlock Text="Режим обработки соединений" FontSize="19" FontWeight="Bold"/>
                  <TextBlock Text="Настройки маршрутов и DNS для профиля NeoTUN. Списки сохраняются отдельно от ссылки сервера и применяются при следующем подключении." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,14"/>
                  <CheckBox x:Name="GlobalProxyToggle" Content="Направлять соединения через выбранный профиль по умолчанию" IsChecked="True" Margin="0,0,0,8"/>
                  <CheckBox x:Name="Ipv6Toggle" Content="Использовать IPv6 в TUN" IsChecked="False" Margin="0,0,0,12"/>
                  <TextBlock Text="MTU интерфейса (1280–1500)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                  <TextBox x:Name="MtuInput" Text="1500" MaxLength="4" Width="150" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                  <TextBlock Text="Порядок правил" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                  <ComboBox x:Name="RouteOrderSelector" SelectedIndex="0" MinHeight="38">
                    <ComboBoxItem Content="Блокировка → Прокси → Напрямую"/>
                    <ComboBoxItem Content="Блокировка → Напрямую → Прокси"/>
                    <ComboBoxItem Content="Прокси → Блокировка → Напрямую"/>
                  </ComboBox>
                </StackPanel>
              </Border>
              <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushNeo}" BorderThickness="1" CornerRadius="18" Padding="20" Margin="0,0,0,14">
                <StackPanel>
                  <TextBlock Text="DNS over HTTPS" FontSize="18" FontWeight="SemiBold"/>
                  <TextBlock Text="Укажите IP-адрес или HTTPS DNS endpoint. Оставьте поле пустым, чтобы не задавать отдельный DNS." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,12"/>
                  <TextBlock Text="Удалённый DNS" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                  <TextBox x:Name="RemoteDnsInput" Text="https://8.8.8.8/dns-query" Margin="0,0,0,12"/>
                  <TextBlock Text="Домашний DNS" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                  <TextBox x:Name="DomesticDnsInput" Text="https://77.88.8.8/dns-query" Margin="0,0,0,12"/>
                  <TextBlock Text="Домены для домашнего DNS" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                  <TextBox x:Name="DomesticDnsDomainsEditor" Text="ru&#10;su&#10;рф" MinHeight="64" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
                </StackPanel>
              </Border>
              <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushNeo}" BorderThickness="1" CornerRadius="18" Padding="20" Margin="0,0,0,14">
                <StackPanel>
                  <TextBlock Text="Правила доменов и IP/CIDR" FontSize="18" FontWeight="SemiBold"/>
                  <TextBlock Text="Каждая строка — одно значение. Примеры: example.org или 192.0.2.0/24." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,14"/>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Margin="0,0,7,12">
                      <TextBlock Text="Блокировать домены" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                      <TextBox x:Name="BlockSitesEditor" MinHeight="76" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="7,0,0,12">
                      <TextBlock Text="Блокировать IP/CIDR" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                      <TextBox x:Name="BlockIpEditor" MinHeight="76" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,0,7,12">
                      <TextBlock Text="Через прокси — домены" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                      <TextBox x:Name="ProxySitesEditor" MinHeight="76" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="7,0,0,12">
                      <TextBlock Text="Через прокси — IP/CIDR" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                      <TextBox x:Name="ProxyIpEditor" MinHeight="76" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Margin="0,0,7,0">
                      <TextBlock Text="Напрямую — домены" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                      <TextBox x:Name="DirectSitesEditor" MinHeight="76" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="7,0,0,0">
                      <TextBlock Text="Напрямую — IP/CIDR" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                      <TextBox x:Name="DirectIpEditor" MinHeight="76" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
                    </StackPanel>
                  </Grid>
                  <TextBlock Text="Исключения процессов (напрямую)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,14,0,5"/>
                  <TextBox x:Name="ProcessExclusionsEditor" MinHeight="62" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
                  <TextBlock Text="Укажите имена исполняемых файлов, по одному на строку, например chrome.exe. Эти процессы будут направляться напрямую." Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                  <WrapPanel Margin="0,16,0,0">
                    <Button Content="Сохранить маршруты" Click="SaveRouting_Click" Background="{StaticResource BrandVioletBrush}" BorderBrush="{StaticResource BrandVioletBrush}" Margin="0,0,8,8"/>
                    <Button Content="Проверить JSON-файл" Click="LoadRouting_Click" Margin="0,0,8,8"/>
                    <Button Content="Экспорт JSON" Click="CopyRouting_Click" Margin="0,0,8,8"/>
                    <Button Content="Сбросить поля" Click="ResetRouting_Click" Margin="0,0,8,8"/>
                  </WrapPanel>
                  <TextBlock x:Name="RoutingSummary" Text="Маршруты ещё не сохранены." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
        <Grid x:Name="SettingsPage" Visibility="Collapsed">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushNeo}" BorderThickness="1" CornerRadius="18" Padding="20" Margin="0,0,0,14">
                <StackPanel>
                  <TextBlock Text="Внешний вид" FontSize="19" FontWeight="Bold"/>
                  <TextBlock Text="Цветовая тема приложения" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,10"/>
                  <ComboBox x:Name="ThemeSelector" SelectedIndex="0" SelectionChanged="ThemeSelector_SelectionChanged" MinHeight="38" Margin="0,0,0,14">
                    <ComboBoxItem Content="Тёмная"/>
                    <ComboBoxItem Content="Светлая"/>
                    <ComboBoxItem Content="OLED — чёрная"/>
                  </ComboBox>
                  <TextBlock Text="Размер текста" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                  <ComboBox x:Name="FontScaleSelector" SelectedIndex="1" SelectionChanged="FontScaleSelector_SelectionChanged" MinHeight="38" Margin="0,0,0,12">
                    <ComboBoxItem Content="Маленький · 85%"/>
                    <ComboBoxItem Content="Стандартный · 100%"/>
                    <ComboBoxItem Content="Крупный · 115%"/>
                    <ComboBoxItem Content="Очень крупный · 130%"/>
                  </ComboBox>
                  <CheckBox x:Name="UiAnimationsToggle" Content="Плавные переходы интерфейса" IsChecked="True" Checked="UiAnimations_Changed" Unchecked="UiAnimations_Changed" Margin="0,0,0,6"/>
                  <TextBlock Text="Размер текста и анимации сохраняются отдельно для этого пользователя." Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
              <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushNeo}" BorderThickness="1" CornerRadius="18" Padding="20" Margin="0,0,0,14">
                <StackPanel>
                  <TextBlock Text="Запуск приложения" FontSize="19" FontWeight="Bold"/>
                  <TextBlock Text="NeoTUN можно запускать автоматически при входе в Windows." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,12"/>
                  <CheckBox x:Name="LaunchWithWindowsToggle" Content="Запускать NeoTUN вместе с Windows" Checked="LaunchWithWindows_Changed" Unchecked="LaunchWithWindows_Changed" Margin="0,0,0,6"/>
                  <CheckBox x:Name="AutoUpdateSubscriptionsToggle" Content="Обновлять подписки при запуске" Checked="AutoUpdateSubscriptions_Changed" Unchecked="AutoUpdateSubscriptions_Changed" Margin="0,8,0,10"/>
                  <TextBlock Text="Интервал обновления подписок" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                  <ComboBox x:Name="SubscriptionIntervalSelector" SelectedIndex="2" SelectionChanged="SubscriptionInterval_SelectionChanged" MinHeight="38">
                    <ComboBoxItem Content="Каждый час"/>
                    <ComboBoxItem Content="Каждые 6 часов"/>
                    <ComboBoxItem Content="Каждые 12 часов"/>
                    <ComboBoxItem Content="Каждые 24 часа"/>
                    <ComboBoxItem Content="Раз в 3 дня"/>
                    <ComboBoxItem Content="Раз в 7 дней"/>
                  </ComboBox>
                  <TextBlock Text="Настройки применяются только для текущего пользователя Windows." Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0"/>
                </StackPanel>
              </Border>
              <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushNeo}" BorderThickness="1" CornerRadius="18" Padding="20" Margin="0,0,0,14">
                <StackPanel>
                  <TextBlock Text="Обновления" FontSize="19" FontWeight="Bold"/>
                  <TextBlock x:Name="AppVersionLabel" Text="" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,10"/>
                  <Button x:Name="CheckUpdatesButton" Content="Проверить новую версию" Click="CheckUpdates_Click" HorizontalAlignment="Left" Background="{StaticResource BrandVioletBrush}" BorderBrush="{StaticResource BrandVioletBrush}"/>
                  <TextBlock x:Name="UpdateSummary" Text="Проверка обновлений не выполнялась." Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                </StackPanel>
              </Border>
              <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushNeo}" BorderThickness="1" CornerRadius="18" Padding="20" Margin="0,0,0,14">
                <StackPanel>
                  <TextBlock Text="Диагностика" FontSize="19" FontWeight="Bold"/>
                  <TextBlock Text="Файлы профилей, маршрутов и журнала хранятся локально в папке NeoTUN в профиле пользователя." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,10"/>
                  <TextBlock x:Name="DataDirectoryLabel" Text="" Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>
                  <WrapPanel>
                    <Button Content="Открыть папку данных" Click="OpenDataFolder_Click" Margin="0,0,8,8"/>
                    <Button Content="Открыть журнал" Click="OpenLog_Click" Margin="0,0,8,8"/>
                    <Button Content="Скопировать диагностику" Click="CopyDiagnostics_Click" Margin="0,0,8,8"/>
                  </WrapPanel>
                  <TextBlock x:Name="SettingsSummary" Text="Настройки хранятся на этом компьютере." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
        <Grid x:Name="LogsPage" Visibility="Collapsed">
          <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushNeo}" BorderThickness="1" CornerRadius="20" Padding="22">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="Журнал приложения" FontSize="19" FontWeight="Bold" Margin="0,0,0,16"/>
              <TextBox x:Name="LogsText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="{StaticResource InputSurfaceBrush}"/>
            </DockPanel>
          </Border>
        </Grid>
      </Grid>

      <TextBlock Grid.Row="2" Text="{Binding Notice}" Foreground="{StaticResource TextMutedBrush}" Margin="2,14,0,0" TextTrimming="CharacterEllipsis"/>
    </Grid>
  </Grid>
</Window>
