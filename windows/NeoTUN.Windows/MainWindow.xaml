<Window x:Class="NeoTUN.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NeoTUN Client" Height="720" Width="1040" MinHeight="600" MinWidth="840"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Closing="MainWindow_Closing">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <!-- Top Navigation & Header Bar -->
      <RowDefinition Height="64"/>
      <!-- Main Content Area -->
      <RowDefinition Height="*"/>
      <!-- Bottom Status & Notice Bar -->
      <RowDefinition Height="32"/>
    </Grid.RowDefinitions>

    <!-- 1. TOP HEADER & NAVIGATION -->
    <Border Grid.Row="0" Background="{StaticResource NavigationBrush}" BorderBrush="{StaticResource BorderBrushNeo}" BorderThickness="0,0,0,1" Padding="18,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Brand Emblem & Title -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource BrandGradient}" Margin="0,0,12,0">
            <TextBlock Text="N" FontWeight="Bold" FontSize="19" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="NeoTUN" FontWeight="Bold" FontSize="17" Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="Desktop Core" FontSize="10" Foreground="{StaticResource BrandVioletLightBrush}" Margin="0,-1,0,0"/>
          </StackPanel>
        </StackPanel>

        <!-- Navigation Tabs -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Button x:Name="TabHome" Content="🏠  Главная" Margin="4,0" Padding="14,8" Click="HomeNav_Click" Background="{StaticResource BrandSoftBrush}" BorderBrush="{StaticResource BorderAccentBrush}"/>
          <Button x:Name="TabServers" Content="🌐  Серверы" Margin="4,0" Padding="14,8" Click="ServersNav_Click" Background="Transparent" BorderBrush="Transparent"/>
          <Button x:Name="TabRouting" Content="🔀  Маршрутизация" Margin="4,0" Padding="14,8" Click="RoutingNav_Click" Background="Transparent" BorderBrush="Transparent"/>
          <Button x:Name="TabSettings" Content="⚙️  Настройки" Margin="4,0" Padding="14,8" Click="SettingsNav_Click" Background="Transparent" BorderBrush="Transparent"/>
          <Button x:Name="TabLogs" Content="📋  Журнал" Margin="4,0" Padding="14,8" Click="LogsNav_Click" Background="Transparent" BorderBrush="Transparent"/>
        </StackPanel>

        <!-- Right Status Badge & Quick Actions -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Border x:Name="HeaderStatusPill" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushNeo}" BorderThickness="1" CornerRadius="14" Padding="10,5" Margin="0,0,8,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Ellipse x:Name="HeaderStatusDot" Width="8" Height="8" Fill="{StaticResource TextMutedBrush}" Margin="0,0,7,0"/>
              <TextBlock x:Name="HeaderStatusLabel" Text="{Binding ConnectionLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
          </Border>
          <Button Content="—" ToolTip="Свернуть в трей" Width="36" Height="36" Padding="0" Click="MinimizeToTray_Click"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 2. MAIN CONTENT HOST -->
    <Grid Grid.Row="1" Margin="20,16,20,10">

      <!-- ================= PAGE 1: HOME ================= -->
      <Grid x:Name="HomePage" Visibility="Visible">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <!-- Hero Connection Card (CornerRadius 24) -->
            <Border x:Name="HeroCard" CornerRadius="20" BorderThickness="1" BorderBrush="{StaticResource BorderAccentBrush}" Background="{StaticResource HeroIdleGradient}" Padding="22,18" Margin="0,0,0,14">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Status & Selected Profile Info -->
                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="HeroStatusDot" Width="10" Height="10" Fill="{StaticResource TextMutedBrush}" Margin="0,0,8,0"/>
                    <TextBlock x:Name="HeroBadgeText" Text="{Binding ConnectionBadgeText}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                  </StackPanel>

                  <TextBlock Text="{Binding ConnectionLabel}" FontSize="27" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,8,0,3"/>
                  <TextBlock Text="{Binding Status}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                  <!-- Selected Server Sub-Card -->
                  <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushNeo}" BorderThickness="1" CornerRadius="14" Padding="14,10" MaxWidth="560" HorizontalAlignment="Left">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>

                      <TextBlock Text="{Binding SelectedProfileCountryFlag}" FontSize="28" VerticalAlignment="Center" Margin="0,0,14,0"/>

                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedProfileName}" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SelectedEndpoint}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,4"/>
                        <StackPanel Orientation="Horizontal">
                          <Border Background="{StaticResource BrandSoftBrush}" CornerRadius="6" Padding="6,2" Margin="0,0,6,0">
                            <TextBlock Text="{Binding SelectedProfileProtocol}" FontSize="10" Foreground="{StaticResource BrandVioletLightBrush}"/>
                          </Border>
                          <Border Background="{StaticResource RaisedSurfaceBrush}" CornerRadius="6" Padding="6,2">
                            <TextBlock Text="{Binding SelectedProfileEngine}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                          </Border>
                        </StackPanel>
                      </StackPanel>

                      <!-- Latency Chip & Switch Button -->
                      <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="14,0,0,0">
                        <Border Background="{StaticResource InputSurfaceBrush}" BorderBrush="{StaticResource BorderBrushNeo}" BorderThickness="1" CornerRadius="8" Padding="8,4" HorizontalAlignment="Right">
                          <TextBlock Text="{Binding SelectedProfilePing}" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </Border>
                        <Button Content="Сменить" Style="{StaticResource OutlineButton}" Padding="8,3" MinHeight="26" FontSize="11" Margin="0,6,0,0" Click="ServersNav_Click"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </StackPanel>

                <!-- Primary action: compact and explicit -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" MinWidth="184">
                  <Button x:Name="HeroConnectButton" Width="184" Height="48" Click="Connect_Click" Style="{StaticResource BrandButton}" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                      <TextBlock Text="⏻" FontSize="20" Foreground="#FFFFFF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding ConnectionButtonText}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Grid>
            </Border>

            <!-- Quick Action Shortcuts -->
            <Grid Margin="0,0,0,16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Button Content="⚡  Проверить пинг" Margin="0,0,6,0" Click="QuickPing_Click"/>
              <Button Grid.Column="1" Content="↻  Переподключить" Margin="3,0" Click="QuickReconnect_Click"/>
              <Button Grid.Column="2" Content="🔀  Маршрутизация" Margin="3,0" Click="RoutingNav_Click"/>
              <Button Grid.Column="3" Content="🔍  Инспектор конфига" Margin="6,0,0,0" Click="InspectConfig_Click"/>
            </Grid>

            <!-- Live speeds and session totals; align with the Android dashboard -->
            <Grid Margin="0,0,0,16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushNeo}" BorderThickness="1" CornerRadius="16" Padding="14" Margin="0,0,5,0">
                <StackPanel>
                  <TextBlock Text="СКАЧИВАНИЕ ↓" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                  <TextBlock Text="{Binding DownloadSpeed}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrandBlueBrush}" Margin="0,8,0,2"/>
                  <TextBlock Text="Текущая скорость" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
              </Border>

              <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushNeo}" BorderThickness="1" CornerRadius="16" Padding="14" Margin="2,0,4,0">
                <StackPanel>
                  <TextBlock Text="ОТПРАВКА ↑" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                  <TextBlock Text="{Binding UploadSpeed}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrandVioletLightBrush}" Margin="0,8,0,2"/>
                  <TextBlock Text="Текущая скорость" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
              </Border>

              <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushNeo}" BorderThickness="1" CornerRadius="16" Padding="14" Margin="3,0,3,0">
                <StackPanel>
                  <TextBlock Text="ПОЛУЧЕНО" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                  <TextBlock Text="{Binding Received}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,8,0,2"/>
                  <TextBlock Text="За текущую сессию" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
              </Border>

              <Border Grid.Column="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushNeo}" BorderThickness="1" CornerRadius="16" Padding="14" Margin="4,0,0,0">
                <StackPanel>
                  <TextBlock Text="ОТПРАВЛЕНО" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                  <TextBlock Text="{Binding Sent}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrandVioletLightBrush}" Margin="0,8,0,2"/>
                  <TextBlock Text="За текущую сессию" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
              </Border>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <!-- ================= PAGE 2: SERVERS & SUBSCRIPTIONS ================= -->
      <Grid x:Name="ServersPage" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Action Toolbar -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushNeo}" BorderThickness="1" CornerRadius="16" Padding="14,10" Margin="0,0,0,12">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Search input -->
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Поиск по имени, протоколу или серверу" VerticalAlignment="Center" Margin="0,0,14,0"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Content="＋  Добавить" Style="{StaticResource BrandButton}" Margin="0,0,8,0" Click="AddServerDialog_Click"/>
              <Button Content="↻  Обновить подписки" Margin="0,0,8,0" Click="RefreshSubscriptions_Click"/>
              <Button Content="⚡  Пинг всех" Click="PingAll_Click"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Grouped Servers & Subscriptions List -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding GroupedProfiles}" Background="Transparent">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,0,0,16">
                  <!-- Subscription Header Card -->
                  <Border Background="{StaticResource RaisedSurfaceBrush}" BorderBrush="{StaticResource BorderBrushNeo}" BorderThickness="1" CornerRadius="14" Padding="14,10" Margin="0,0,0,8">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>

                      <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                          <TextBlock Text="📦  " FontSize="14"/>
                          <TextBlock Text="{Binding Title}" ToolTip="{Binding Title}" TextTrimming="CharacterEllipsis" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                          <Border Background="{StaticResource BrandSoftBrush}" CornerRadius="6" Padding="6,1" Margin="8,0,0,0">
                            <TextBlock Text="{Binding Count, StringFormat='{}{0} серверов'}" FontSize="10" Foreground="{StaticResource BrandVioletLightBrush}"/>
                          </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Subtitle}" ToolTip="{Binding Subtitle}" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="20,2,0,0"/>
                      </StackPanel>

                      <!-- Subscription Action Buttons -->
                      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding HasSubscription, Converter={StaticResource BoolToVisConverter}}">
                        <Button Content="↻" ToolTip="Обновить эту подписку" Width="32" Height="32" Padding="0" Margin="0,0,6,0" Tag="{Binding Subscription}" Click="RefreshSingleSubscription_Click"/>
                        <Button Content="✎" ToolTip="Редактировать подписку" Width="32" Height="32" Padding="0" Margin="0,0,6,0" Tag="{Binding Subscription}" Click="EditSubscription_Click"/>
                        <Button Content="🗑" ToolTip="Удалить подписку" Style="{StaticResource DangerButton}" Width="32" Height="32" Padding="0" Tag="{Binding Subscription}" Click="DeleteSubscription_Click"/>
                      </StackPanel>
                    </Grid>
                  </Border>

                  <!-- Profiles in this Group -->
                  <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushNeo}" BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="0,0,0,6">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto"/>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="Auto"/>
                              <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Flag & Selection Radio/Button -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                              <TextBlock Text="{Binding CountryFlag}" FontSize="24" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            </StackPanel>

                            <!-- Details -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                              <TextBlock Text="{Binding Endpoint}" ToolTip="{Binding Endpoint}" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,4"/>
                              <StackPanel Orientation="Horizontal">
                                <Border Background="{StaticResource InputSurfaceBrush}" CornerRadius="4" Padding="5,1" Margin="0,0,6,0">
                                  <TextBlock Text="{Binding Protocol}" FontSize="10" Foreground="{StaticResource BrandVioletLightBrush}"/>
                                </Border>
                                <Border Background="{StaticResource RaisedSurfaceBrush}" CornerRadius="4" Padding="5,1">
                                  <TextBlock Text="{Binding EngineLabel}" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                </Border>
                              </StackPanel>
                            </StackPanel>

                            <!-- Ping Badge -->
                            <Border Grid.Column="2" Background="{StaticResource InputSurfaceBrush}" BorderBrush="{StaticResource BorderBrushNeo}" BorderThickness="1" CornerRadius="8" Padding="8,4" VerticalAlignment="Center" Margin="10,0">
                              <TextBlock Text="{Binding DisplayPing}" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </Border>

                            <!-- Action Buttons -->
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                              <Button Content="Выбрать" ToolTip="Выбрать этот сервер" Padding="10,6" Margin="0,0,6,0" Tag="{Binding}" Click="SelectProfile_Click"/>
                              <Button Content="⚡" ToolTip="Проверить задержку" Width="32" Height="32" Padding="0" Margin="0,0,6,0" Tag="{Binding}" Click="PingProfile_Click"/>
                              <Button Content="✎" ToolTip="Редактировать параметры" Width="32" Height="32" Padding="0" Margin="0,0,6,0" Tag="{Binding}" Click="EditProfile_Click"/>
                              <Button Content="📋" ToolTip="Конфиг JSON и возможности" Width="32" Height="32" Padding="0" Margin="0,0,6,0" Tag="{Binding}" Click="ShowProfileConfig_Click"/>
                              <Button Content="🗑" ToolTip="Удалить профиль" Style="{StaticResource DangerButton}" Width="32" Height="32" Padding="0" Tag="{Binding}" Click="DeleteProfile_Click"/>
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>

      <!-- ================= PAGE 3: ROUTING ================= -->
      <Grid x:Name="RoutingPage" Visibility="Collapsed">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <!-- Routing Profiles Switcher Bar (18px radius) -->
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushNeo}" BorderThickness="1" CornerRadius="18" Padding="18,14" Margin="0,0,0,16">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Профиль маршрутизации:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,14,0"/>

                <ComboBox x:Name="RoutingProfileSelector" Grid.Column="1" ItemsSource="{Binding RoutingProfiles}" DisplayMemberPath="Name" SelectedItem="{Binding ActiveRoutingProfile, Mode=TwoWay}" SelectionChanged="RoutingProfileSelector_SelectionChanged" VerticalAlignment="Center" Margin="0,0,14,0"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                  <Button Content="＋  Новый" Margin="0,0,6,0" Click="NewRoutingProfile_Click"/>
                  <Button Content="📥  Импорт из ссылки / Base64" Margin="0,0,6,0" Click="ImportRoutingProfile_Click"/>
                  <Button Content="🗑  Удалить" Style="{StaticResource DangerButton}" Click="DeleteRoutingProfile_Click"/>
                </StackPanel>
              </Grid>
            </Border>

            <!-- Profile Parameters (General) -->
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushNeo}" BorderThickness="1" CornerRadius="18" Padding="20" Margin="0,0,0,16">
              <StackPanel>
                <TextBlock Text="ПАРАМЕТРЫ ПРОФИЛЯ" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrandVioletLightBrush}" Margin="0,0,0,14"/>
                <CheckBox Content="Включить пользовательские правила маршрутизации (Proxy / Direct / Block)" IsChecked="{Binding RoutingEnabled, Mode=TwoWay}" ToolTip="При выключении сохраняемый профиль не удаляется; изменения применяются при следующем подключении." Margin="0,0,0,14" FontWeight="SemiBold"/>

                <Grid Margin="0,0,0,14">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="Имя профиля" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <TextBox x:Name="RoutingNameInput" Text="{Binding ActiveRoutingProfile.Name, Mode=TwoWay}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="Порядок правил (RouteOrder)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <ComboBox x:Name="RouteOrderComboBox" SelectedIndex="{Binding ActiveRoutingProfile.RouteOrder, Mode=TwoWay}">
                      <ComboBoxItem Content="Block → Proxy → Direct (по умолчанию)"/>
                      <ComboBoxItem Content="Block → Direct → Proxy"/>
                      <ComboBoxItem Content="Proxy → Block → Direct"/>
                    </ComboBox>
                  </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <CheckBox x:Name="GlobalProxyCheckBox" Content="Глобальный прокси (весь остальной трафик в VPN)" IsChecked="{Binding ActiveRoutingProfile.GlobalProxy, Mode=TwoWay}" VerticalAlignment="Center"/>
                  <CheckBox Grid.Column="1" x:Name="Ipv6CheckBox" Content="Включить IPv6 маршрутизацию" IsChecked="{Binding ActiveRoutingProfile.Ipv6Enabled, Mode=TwoWay}" VerticalAlignment="Center"/>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="MTU: " VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBox x:Name="MtuInputBox" Text="{Binding ActiveRoutingProfile.Mtu, Mode=TwoWay}" Width="70" Margin="6,0,0,0"/>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <!-- DNS Configuration -->
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushNeo}" BorderThickness="1" CornerRadius="18" Padding="20" Margin="0,0,0,16">
              <StackPanel>
                <TextBlock Text="DNS КОНФИГУРАЦИЯ" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrandVioletLightBrush}" Margin="0,0,0,14"/>

                <Grid Margin="0,0,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="Удалённый DNS (Remote DNS)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <TextBox x:Name="RemoteDnsBox" Text="{Binding ActiveRoutingProfile.RemoteDns, Mode=TwoWay}"/>
                    <TextBlock Text="Для туннелируемого трафика (например https://8.8.8.8/dns-query)" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                  </StackPanel>

                  <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="Домашний DNS (Domestic DNS)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <TextBox x:Name="DomesticDnsBox" Text="{Binding ActiveRoutingProfile.DomesticDns, Mode=TwoWay}"/>
                    <TextBlock Text="Для прямого локального трафика (например https://77.88.8.8/dns-query)" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                  </StackPanel>
                </Grid>

                <TextBlock Text="Домены для Домашнего DNS (по строкам):" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,6"/>
                <TextBox x:Name="DomesticDomainsBox" Text="{Binding ActiveRoutingProfile.DomesticDnsDomains, Mode=TwoWay}" Height="54" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
              </StackPanel>
            </Border>

            <!-- Rule Lists: Block, Proxy, Direct, Process Exclusions -->
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushNeo}" BorderThickness="1" CornerRadius="18" Padding="20" Margin="0,0,0,16">
              <StackPanel>
                <TextBlock Text="ПРАВИЛА ТРАФИКА И ИСКЛЮЧЕНИЯ" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrandVioletLightBrush}" Margin="0,0,0,14"/>

                <!-- Block Rules -->
                <TextBlock Text="🚫 Блокировка (Block Sites &amp; Block IP)" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource DangerBrush}" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="Домены / geosite для блокировки:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="BlockSitesBox" Text="{Binding ActiveRoutingProfile.BlockSites, Mode=TwoWay}" Height="70" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="IP / CIDR / geoip для блокировки:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="BlockIpBox" Text="{Binding ActiveRoutingProfile.BlockIp, Mode=TwoWay}" Height="70" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                  </StackPanel>
                </Grid>

                <!-- Proxy Rules -->
                <TextBlock Text="🌐 Прокси (Proxy Sites &amp; Proxy IP)" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource BrandVioletLightBrush}" Margin="0,4,0,6"/>
                <Grid Margin="0,0,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="Домены / geosite для прокси:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="ProxySitesBox" Text="{Binding ActiveRoutingProfile.ProxySites, Mode=TwoWay}" Height="70" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="IP / CIDR / geoip для прокси:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="ProxyIpBox" Text="{Binding ActiveRoutingProfile.ProxyIp, Mode=TwoWay}" Height="70" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                  </StackPanel>
                </Grid>

                <!-- Direct Rules -->
                <TextBlock Text="⚡ Прямое соединение (Direct Sites &amp; Direct IP)" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource SuccessBrush}" Margin="0,4,0,6"/>
                <Grid Margin="0,0,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="Домены / geosite для прямого выхода:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="DirectSitesBox" Text="{Binding ActiveRoutingProfile.DirectSites, Mode=TwoWay}" Height="70" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="IP / CIDR / geoip для прямого выхода:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="DirectIpBox" Text="{Binding ActiveRoutingProfile.DirectIp, Mode=TwoWay}" Height="70" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                  </StackPanel>
                </Grid>

                <!-- Process Exclusions -->
                <TextBlock Text="💻 Исключения процессов Windows (в обход VPN)" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource WarningBrush}" Margin="0,4,0,6"/>
                <TextBlock Text="Имена .exe процессов по строкам (например: telegram.exe, discord.exe, steam.exe):" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="ProcessExclusionsBox" Text="{Binding ActiveRoutingProfile.ProcessExclusions, Mode=TwoWay}" Height="60" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>

                <!-- Save & Actions Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                  <Button Content="💾  Сохранить профиль" Style="{StaticResource BrandButton}" Padding="20,10" Margin="0,0,10,0" Click="SaveRouting_Click"/>
                  <Button Content="Копировать JSON" Click="CopyRoutingJson_Click"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <!-- ================= PAGE 4: SETTINGS ================= -->
      <Grid x:Name="SettingsPage" Visibility="Collapsed">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <!-- Appearance Card (18px radius) -->
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushNeo}" BorderThickness="1" CornerRadius="18" Padding="20" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="ВНЕШНИЙ ВИД" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrandVioletLightBrush}" Margin="0,0,0,14"/>

                <Grid Margin="0,0,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>

                  <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="Тема оформления" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <ComboBox x:Name="SettingsThemeSelector" SelectionChanged="SettingsTheme_SelectionChanged">
                      <ComboBoxItem Content="Тёмная (Dark)"/>
                      <ComboBoxItem Content="Светлая (Light)"/>
                      <ComboBoxItem Content="OLED — чёрная"/>
                    </ComboBox>
                  </StackPanel>

                  <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="Масштаб шрифта" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <ComboBox x:Name="SettingsFontScaleSelector" IsEnabled="False" ToolTip="Масштабирование шрифтов по всему интерфейсу пока не реализовано." SelectionChanged="SettingsFontScale_SelectionChanged">
                      <ComboBoxItem Content="Маленький · 85%"/>
                      <ComboBoxItem Content="Стандартный · 100%"/>
                      <ComboBoxItem Content="Крупный · 115%"/>
                      <ComboBoxItem Content="Очень крупный · 130%"/>
                    </ComboBox>
                  </StackPanel>
                </Grid>

                <CheckBox x:Name="SettingsUiAnimations" Content="Плавные переходы интерфейса" IsChecked="True" IsEnabled="False" ToolTip="Анимации переходов пока не реализованы."/>
              </StackPanel>
            </Border>

            <!-- Subscriptions Card -->
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushNeo}" BorderThickness="1" CornerRadius="18" Padding="20" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="ПОДПИСКИ" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrandVioletLightBrush}" Margin="0,0,0,14"/>

                <CheckBox x:Name="SettingsAutoUpdateSubscriptions" Content="Обновлять подписки при запуске NeoTUN" IsChecked="True" Margin="0,0,0,10" Checked="SettingsAutoUpdateSubscriptions_Changed" Unchecked="SettingsAutoUpdateSubscriptions_Changed"/>

                <TextBlock Text="Интервал фонового обновления" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                <ComboBox x:Name="SettingsSubInterval" SelectionChanged="SettingsSubInterval_SelectionChanged" Width="260" HorizontalAlignment="Left">
                  <ComboBoxItem Content="Каждый час"/>
                  <ComboBoxItem Content="Каждые 6 часов"/>
                  <ComboBoxItem Content="Каждые 12 часов"/>
                  <ComboBoxItem Content="Каждые 24 часа"/>
                  <ComboBoxItem Content="Раз в 3 дня"/>
                  <ComboBoxItem Content="Раз в 7 дней"/>
                </ComboBox>
              </StackPanel>
            </Border>

            <!-- Network & Ping Card -->
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushNeo}" BorderThickness="1" CornerRadius="18" Padding="20" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="СЕТЬ И ПРОВЕРКА ЗАДЕРЖКИ" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrandVioletLightBrush}" Margin="0,0,0,14"/>

                <Grid Margin="0,0,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>

                  <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="Режим проверки пинга" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <ComboBox x:Name="SettingsPingModeSelector" IsEnabled="False" SelectedIndex="0" ToolTip="Сейчас используется TCP handshake. Другие режимы ещё не реализованы.">
                      <ComboBoxItem Content="TCP Handshake (быстрый)"/>
                      
                    </ComboBox>
                  </StackPanel>

                  <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="Таймаут пинга (мс)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <TextBox x:Name="SettingsPingTimeoutBox" Text="3500" ToolTip="Таймаут TCP-проверки сервера, 500–30000 мс" LostFocus="SettingsPingTimeout_LostFocus"/>
                  </StackPanel>
                </Grid>

                <CheckBox x:Name="SettingsAutoReconnect" Content="Автоматически переподключаться при обрыве соединения" IsEnabled="False" ToolTip="Автоматическое переподключение пока не реализовано."/>
              </StackPanel>
            </Border>

            <!-- Windows System Integration -->
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushNeo}" BorderThickness="1" CornerRadius="18" Padding="20" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="СИСТЕМА И ТРЕЙ" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrandVioletLightBrush}" Margin="0,0,0,14"/>

                <CheckBox x:Name="SettingsLaunchWithWindows" Content="Запускать NeoTUN вместе с Windows" Margin="0,0,0,8" Click="LaunchWithWindows_Click"/>
                <CheckBox x:Name="SettingsMinimizeToTrayOnClose" Content="Сворачивать в системный трей при закрытии окна (крестик)" IsChecked="True" Margin="0,0,0,8" Checked="SettingsMinimizeToTray_Changed" Unchecked="SettingsMinimizeToTray_Changed"/>
                <CheckBox x:Name="SettingsMinimizeToTrayOnStart" Content="Запускать свёрнутым в трей" IsChecked="False" Checked="SettingsMinimizeToTray_Changed" Unchecked="SettingsMinimizeToTray_Changed"/>
              </StackPanel>
            </Border>

            <!-- App Updates Card -->
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushNeo}" BorderThickness="1" CornerRadius="18" Padding="20" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="ОБНОВЛЕНИЯ" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrandVioletLightBrush}" Margin="0,0,0,14"/>
                <TextBlock x:Name="SettingsVersionLabel" Text="NeoTUN Windows v0.1.1" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal">
                  <Button Content="Проверить обновления" Style="{StaticResource BrandButton}" Click="CheckUpdates_Click" Margin="0,0,8,0"/>
                  <Button Content="Открыть GitHub Releases" Click="OpenGitHubReleases_Click"/>
                </StackPanel>
                <TextBlock x:Name="SettingsUpdateSummary" Text="Проверка обновлений не производилась." FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>

            <!-- Reset Settings -->
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushNeo}" BorderThickness="1" CornerRadius="18" Padding="20" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="СБРОС" FontSize="12" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" Margin="0,0,0,14"/>
                <TextBlock Text="Сброс восстановит параметры тем, таймеров и путей к начальным значениям." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10"/>
                <Button Content="Сбросить все настройки" Style="{StaticResource DangerButton}" HorizontalAlignment="Left" Click="ResetSettings_Click"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <!-- ================= PAGE 5: LOGS & DIAGNOSTICS ================= -->
      <Grid x:Name="LogsPage" Visibility="Collapsed">
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushNeo}" BorderThickness="1" CornerRadius="18" Padding="20">
          <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="ЖУРНАЛ И ДИАГНОСТИКА" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="События жизненного цикла движков sing-box и Xray, Wintun и сети" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
              </StackPanel>

              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Скопировать всё" Margin="0,0,8,0" Click="CopyLogs_Click"/>
                <Button Content="Очистить" Margin="0,0,8,0" Click="ClearLogs_Click"/>
                <Button Content="Открыть папку данных" Click="OpenDataFolder_Click"/>
              </StackPanel>
            </Grid>

            <TextBox x:Name="LogsTextBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas, monospace" FontSize="12" Background="{StaticResource InputSurfaceBrush}" Foreground="{StaticResource TextPrimaryBrush}"/>
          </DockPanel>
        </Border>
      </Grid>

    </Grid>

    <!-- 3. BOTTOM STATUS & NOTICE BAR -->
    <Border Grid.Row="2" Background="{StaticResource NavigationBrush}" BorderBrush="{StaticResource BorderBrushNeo}" BorderThickness="0,1,0,0" Padding="18,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="{Binding Notice}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        <TextBlock Grid.Column="1" Text="NeoTUN Windows 64-bit • Wintun 0.14.1" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
      </Grid>
    </Border>

    <!-- MODAL OVERLAY (Used for Profile Editor, Add Dialog, Config Inspector, Capabilities) -->
    <Grid x:Name="ModalOverlay" Grid.RowSpan="3" Background="#AA0B0815" Visibility="Collapsed">
      <Border x:Name="ModalContainer" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderAccentBrush}" BorderThickness="1" CornerRadius="20" Padding="24" MaxWidth="620" MaxHeight="600" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid x:Name="ModalContentRoot"/>
      </Border>
    </Grid>
  </Grid>
</Window>
